PORT=4100
HOST=127.0.0.1
# Neon PostgreSQL connection string from the Neon Console's Connect dialog.
# Use the pooled connection string for the app server and keep sslmode=require.
# Leave empty to use the persistent local embedded PostgreSQL database.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=verify-full
DATABASE_PATH=./data
# Production: use a real PostgreSQL server, HTTPS proxy and explicit origins.
CORS_ORIGINS=http://localhost:5300,http://127.0.0.1:5300,http://localhost:4100,http://127.0.0.1:4100
# OpenRouter's OpenAI-compatible API. Keep the API key server-side.
AI_BASE_URL=https://openrouter.ai/api/v1
# Routes each request to a compatible free model on OpenRouter.
AI_MODEL=openrouter/free
AI_API_KEY=your_openrouter_api_key
# Optional calendar service owned by Moncef. Generates proposals, never applies them.
PLANNING_API_URL=
# Set to a random secret to accept verified completion events from other services.
INTEGRATION_TOKEN=
